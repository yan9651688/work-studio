{
  "name": "creation-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @studio/server dev\" \"pnpm --filter @studio/web dev\"",
    "build": "pnpm --filter @studio/web build && pnpm --filter @studio/server build",
    "start": "node apps/server/dist/index.js",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @studio/server db:migrate",
    "db:seed": "pnpm --filter @studio/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "openai": "^7.47.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
